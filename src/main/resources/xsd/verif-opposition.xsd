<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="http://local.verifopposition"
           xmlns:tns="http://local.verifopposition" 
           elementFormDefault="qualified">

    <xs:element name="VerifOppositionRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="numeroImmatriculation" type="xs:string"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="VerifOppositionResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="opposition" type="xs:boolean"/>
                <xs:element name="message" type="xs:string"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

</xs:schema>